# GlamAI Dashboard Environment

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional admin secret (matches ADMIN_API_SECRET on API)
NEXT_PUBLIC_ADMIN_SECRET=

# Disable Clerk for local dev (or leave keys empty — Clerk auto-disables)
NEXT_PUBLIC_DISABLE_CLERK=true

# Demo mode banner on marketing pages (disable in production)
NEXT_PUBLIC_DEMO_MODE=false

# Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/admin
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/client/onboarding
