# Railway environment template — API, worker, and beat services
# Copy variables into each service in the Railway dashboard.
# Reference Postgres/Redis plugin variables with ${{Postgres.DATABASE_URL}} syntax.

# ── Core ─────────────────────────────────────────────────────
APP_ENV=production
APP_BASE_URL=https://glamai-api.up.railway.app
APP_CORS_ORIGINS=["https://glamai-dashboard.up.railway.app"]
APP_SECRET_KEY=generate-with-openssl-rand-hex-32

# ── Data stores (reference Railway plugins) ──────────────────
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}

# ── LLM ──────────────────────────────────────────────────────
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# ── Security ─────────────────────────────────────────────────
ADMIN_API_SECRET=
ENCRYPTION_KEY=

# ── Rankings ─────────────────────────────────────────────────
SERPAPI_KEY=

# ── Google GBP ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://glamai-api.up.railway.app/api/v1/gbp/oauth/callback
GOOGLE_PLACES_API_KEY=

# ── WhatsApp ─────────────────────────────────────────────────
# Webhook URL for 360dialog/Meta: https://<api-host>/api/webhooks/whatsapp/
WHATSAPP_PROVIDER=360dialog
WHATSAPP_API_KEY=
WHATSAPP_360DIALOG_API_KEY=
WHATSAPP_BASE_URL=https://waba.360dialog.io/v1
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ── Email ────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=GlamAI <reports@glamai.in>

# ── Storage (use S3 or mount a Railway volume at STORAGE_LOCAL_PATH) ──
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/app/media

# ── Feature flags ────────────────────────────────────────────
FEATURE_REVIEW_ENGINE=true
FEATURE_REENGAGEMENT=true
FEATURE_CONTENT_GENERATOR=true
